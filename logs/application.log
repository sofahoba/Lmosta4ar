ent_date":"2024-01-09","statement_summary":"شاهد محمود سعيد في شارع النيل مساء يوم 9 يناير شجارًا بين رجلين، تعرف على أحدهما لاحقًا باسم أحمد محمد علي ورآه يضرب عصا خشبية على رأس الرجل الآخر فتسقطه. نادى على المساعدة، نزل سيدة من شرفة واتصلوا بالإسعاف والشرطة. المتهم هرب ثم ألقي القبض عليه لاحقًا. لا توجد صلة سابقة بينه وبين المتهم أو المجني عليه.","was_sworn_in":true,"presence_at_scene":true,"source_document_id":"efe14ec9-e7a7-40a2-b62d-15d0867e5b33_aqual_elshuhud"},{"witness_name":"فاطمة علي","witness_type":"شاهد نفي","occupation":null,"id_number":null,"relation_to_defendant":"زوجة","statement_date":"2024-01-09","statement_summary":"أعلنت فاطمة علي أن زوجها أحمد محمد علي لم يغادر المنزل طوال ليلة 9 يناير، كان جالسًا معها من بعد صلاة العشاء حتى الصباح، وأنها لا تعرف شيئًا عن الحادثة ولا تصدق أن زوجها قد يؤذي أحدًا، مشيرة إلى أنه رجل هادئ ولم تصدر منه أي مشكلة من قبل.","was_sworn_in":null,"presence_at_scene":false,"source_document_id":"efe14ec9-e7a7-40a2-b62d-15d0867e5b33_aqual_elshuhud"}],"confessions":[{"defendant_name":"أحمد محمد علي","text":"اعترف المتهم بأنه كان في شارع النيل مساء ذلك اليوم وضرب المتهم الآخر بسلاح بسيط (عصا) دفاعًا عن نفسه بعد أن هاجمه سعيد عبد الله بسكين، لكنه أنكر أنه كان ينوي القتل وأعرب عن ندمه على النتيجة المميتة للضربة. كما أبدى تظلمًا من تعرضه لضغوط جسدية أثناء الاستجواب.","confession_date":"2024-01-11","confession_stage":"تحقيق","legal_counsel_present":false,"coercion_claimed":true,"key_admissions":["كان في شارع النيل مساء ذلك اليوم","ضرب المتهم الآخر دفاعًا عن نفسه","لم يكن يعلم أن الضربة ستكون بهذه الخطورة","نادم على ما حدث"],"source_document_id":"3540c443-1290-4b11-831c-102bf5d85752_mahdar_istijwab"}],"lab_reports":[{"report_type":"طبي شرعي","report_number":"47 / 2024","examination_date":"2024-01-10","examiner_name":"الدكتور خالد إبراهيم منصور","prosecutor_name":null,"items_sent_for_analysis":[],"result":"وُجد جرح رضيع غائر بقطر نحو 9 سم في الجانب الأيسر من الجمجمة مع كسر في عظام الجمجمة ونزيف حاد داخل التجويف الجمغري ونزيف تحت الجافية في الفص الجداري الأيسر، مما أدى إلى ضغط شديد على أنسجة المخ.","linked_defendant_name":null,"source_document_id":"b1addf91-1d0b-46cd-ad14-46ebf9c9484d_taqrir_tibbi"}],"criminal_records":[],"criminal_proceedings":[{"procedure_type":"تفتيش","description":"تفتيش مكان الحادث وعثور على عصا خشبية ملطخة بآثار دماء.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"},{"procedure_type":"ضبط","description":"جرى ضبط المتهم أحمد محمد علي في منزله بشارع الورود رقم 12 بالجيزة في الساعة الثالثة صباحًا وتم اصطحابه إلى مقر القسم لاستكمال الإجراءات.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"}],"defense_documents":[{"submitted_by":"عمر فاروق","defendant_name":"أحمد محمد علي","formal_defenses":["بطلان الاعتراف"],"substantive_defenses":["الدفاع الشرعي","انتفاء القصد الجنائي"],"supporting_principles":["المادة مئة وأربعة وعشرين من قانون الإجراءات الجنائية","المادة الثلاثة والعشرين وما بعدها من قانون العقوبات","حكمت محكمة النقض في جلسة الحادي والعشرين من يناير عام 1982 بأن الاعتراف المنتزع بطريق الإكراه أو بالمخالفة للإجراءات القانونية يقع باطلًا ولا يعتد به"],"alibi_claimed":true,"alibi_description":"تشهد زوجة موكلي بأنه لم يغادر المنزل ليلة الحادث","source_document_id":"9b078a69-0290-45b1-b6ca-385ba5ed00a6_mozakeret_difa"}],"procedural_audit":{"violations":[{"procedure_source":"وقائع الدعوى","procedure_type":"تفتيش","issue_description":"إجراء تفتيش مكان الحادث دون وجود أمر قضائي أو إذن من النيابة العامة.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","nullity_type":"بطلان مطلق","nullity_effect":"لا يعتد بأي دليل مستمد من هذا التفتيش.","article_basis":"المادة 45 من قانون الإجراءات الجنائية","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"},{"procedure_source":"وقائع الدعوى","procedure_type":"ضبط","issue_description":"إجراء القبض على المتهم أحمد محمد علي دون وجود أمر قضا