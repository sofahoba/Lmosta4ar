ية في الفص الجداري الأيسر، مما أدى إلى ضغط شديد على أنسجة المخ.","linked_defendant_name":null,"source_document_id":"b1addf91-1d0b-46cd-ad14-46ebf9c9484d_taqrir_tibbi"}],"criminal_records":[],"criminal_proceedings":[{"procedure_type":"تفتيش","description":"تفتيش مكان الحادث وعثور على عصا خشبية ملطخة بآثار دماء.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"},{"procedure_type":"ضبط","description":"جرى ضبط المتهم أحمد محمد علي في منزله بشارع الورود رقم 12 بالجيزة في الساعة الثالثة صباحًا وتم اصطحابه إلى مقر القسم لاستكمال الإجراءات.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"}],"defense_documents":[{"submitted_by":"عمر فاروق","defendant_name":"أحمد محمد علي","formal_defenses":["بطلان الاعتراف"],"substantive_defenses":["الدفاع الشرعي","انتفاء القصد الجنائي"],"supporting_principles":["المادة مئة وأربعة وعشرين من قانون الإجراءات الجنائية","المادة الثلاثة والعشرين وما بعدها من قانون العقوبات","حكمت محكمة النقض في جلسة الحادي والعشرين من يناير عام 1982 بأن الاعتراف المنتزع بطريق الإكراه أو بالمخالفة للإجراءات القانونية يقع باطلًا ولا يعتد به"],"alibi_claimed":true,"alibi_description":"تشهد زوجة موكلي بأنه لم يغادر المنزل ليلة الحادث","source_document_id":"9b078a69-0290-45b1-b6ca-385ba5ed00a6_mozakeret_difa"}],"procedural_audit":{"violations":[{"procedure_source":"وقائع الدعوى","procedure_type":"تفتيش","issue_description":"إجراء تفتيش مكان الحادث دون وجود أمر قضائي أو إذن من النيابة العامة.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","nullity_type":"بطلان مطلق","nullity_effect":"لا يعتد بأي دليل مستمد من هذا التفتيش.","article_basis":"المادة 45 من قانون الإجراءات الجنائية","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"},{"procedure_source":"وقائع الدعوى","procedure_type":"ضبط","issue_description":"إجراء القبض على المتهم أحمد محمد علي دون وجود أمر قضا