ر محمود سعيد أنه كان يسير في شارع النيل مساء التاسع من يناير عندما سمع شجارًا، ثم رأى رجلين يتشاجران. تعرف لاحقًا على أحدهما باسم أحمد محمد علي، ورآه يمسك عصا خشبية ويضرب الرجل الآخر ضربة قوية على رأسه مما أدى إلى سقوطه. ركض لاستغاثة الشرطة والإسعاف، وأشار إلى أن المتهم هرب في البداية ثم تم القبض عليه لاحقًا. صرح بأنه لا تربطه أي صلة بالمتهم أو بالمجني عليه.","was_sworn_in":true,"presence_at_scene":true,"source_document_id":"efe14ec9-e7a7-40a2-b62d-15d0867e5b33_aqual_elshuhud"},{"witness_name":"فاطمة علي","witness_type":"شاهد نفي","occupation":null,"id_number":null,"relation_to_defendant":"زوجة المتهم أحمد محمد علي","statement_date":null,"statement_summary":"أعلنت فاطمة علي، زوجة المتهم أحمد محمد علي، أنها لم تغادر المنزل طوال ليلة التاسع من يناير، وكانت جالسة معه في البيت من بعد صلاة العشاء حتى الصباح. نفت معرفتها بأي تفاصيل عن الحادثة وأكدت عدم إمكانية زوجها أن يؤذي أحدًا، ووصفته بأنه رجل هادئ لم يصدر منه أي مشكلة من قبل.","was_sworn_in":true,"presence_at_scene":false,"source_document_id":"efe14ec9-e7a7-40a2-b62d-15d0867e5b33_aqual_elshuhud"}],"confessions":[{"defendant_name":"أحمد محمد علي","text":"أنكر المتهم القصد في القتل لكنه اعترف بأنه كان في شارع النيل مساء ذلك اليوم، وأنه تعرض لهجوم من قبل سعيد عبد الله الذي كان يحمل سكينًا، فاستعمل عصاً على الأرض لضربه دفاعًا عن نفسه، وأقر بأنه لم يكن يعلم أن الضربة ستؤدي إلى الموت، وأبدى ندمه على ما حدث.","confession_date":"2024-01-11","confession_stage":"تحقيق","legal_counsel_present":false,"coercion_claimed":true,"key_admissions":["كان في شارع النيل مساء ذلك اليوم","ضرب المتهم المتهم الآخر دفاعًا عن نفسه","لم يكن يعلم أن الضربة ستكون بهذه الخطورة","نادم على ما حدث"],"source_document_id":"3540c443-1290-4b11-831c-102bf5d85752_mahdar_istijwab"}],"lab_reports":[{"report_type":"طبي شرعي","report_number":"47 / 2024","examination_date":"2024-01-10","examiner_name":"الدكتور خالد إبراهيم منصور","prosecutor_name":null,"items_sent_for_analysis":[],"result":"لوحظ وجود جرح رضيع غائر في الجانب الأيسر من الجمجمة بقطر نحو تسعة سنتيمترات مع آثار نزيف حول موضع الإصابة، وكسر في عظام الجمجمة مع نزيف حاد داخل تجويف الجمجمة وضغط شديد على أنسجة المخ، بالإضافة إلى نزيف تحت الجافية في الفص الجداري الأيسر.","linked_defendant_name":null,"source_document_id":"b1addf91-1d0b-46cd-ad14-46ebf9c9484d_taqrir_tibbi"}],"criminal_records":[],"criminal_proceedings":[{"procedure_type":"تفتيش","description":"تفتيش مكان الحادث وعثور على عصا خشبية ملطخة بآثار دماء.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"},{"procedure_type":"ضبط","description":"ضبط المتهم أحمد محمد علي في منزله بشارع الورود رقم 12 بالجيزة في الساعة الثالثة صباحًا وتم اصطحابه إلى مقر القسم لاستكمال الإجراءات.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"}],"defense_documents":[{"submitted_by":"عمر فاروق","defendant_name":"أحمد محمد علي","formal_defenses":["بطلان الاعتراف"],"substantive_defenses":["الدفاع الشرعي","انتفاء القصد الجنائي"],"supporting_principles":["حكمت محكمة النقض في جلسة الحادي والعشرين من يناير عام 1982","المادة 124 من قانون الإجراءات الجنائية","المادة 23 من قانون العقوبات"],"alibi_claimed":true,"alibi_description":"تشهد زوجة موكلي بأنه لم يغادر المنزل ليلة الحادث","source_document_id":"9b078a69-0290-45b1-b6ca-385ba5ed00a6_mozakeret_difa"}],"procedural_audit":{"violations":[{"procedure_source":"وقائع الدعوى","procedure_type":"تفتيش","issue_description":"تفتيش مكان الحادث بدون أمر قضائي أو إذن من النيابة العامة.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","nullity_type":"بطلان مطلق","nullity_effect":"لا يعتد بالدليل المستمد من هذا التفتيش.","article_basis":"المادة 45 من قانون الإجراءات الجنائية","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"},{"procedure_source":"وقائع الدعوى","procedure_type":"ضبط","issue_description":"ضبط المتهم بدون أمر قضائي أو وجود حالة تلبس.","warrant_present":false,"conducting_officer":"النقيب محمود حسن","nullity_type":"بطلان مطلق","nullity_effect":"لا يعتد بالدليل المستمد من هذا الضبط.","article_basis":"المادة 280 من قانون العقوبات","source_document_id":"82c90619-54bc-4695-87dd-6ae5cb90b602_mahdar_dabt"}],"excluded_defense_claims":[{"claim":"بطلان الاعتراف","reason":"لا يوجد في الوقائع ما يشير إلى أن الاعتراف كان منتزعاً بالإكراه."}],"overall_assessment":"توجد مخالفات إجرائية خطيرة تتعلق بالتفتيش والضبط بدون أمر قضائي أو وجود حالة تلبس، مما يؤدي إلى بطلان مطلق للدليل المستمد من هذه الإجراءات.","critical_nullities":["بطلان التفتيش بدون أمر قضائي أو إذن من النيابة العامة.","بطلان الضبط بدون أمر قضائي أو وجود حالة تلبس."],"kg_articles_used":["المادة 45 من قانون الإجراءات الجنائية","المادة 280 من قانون العقوبات"],"meta":{}},"evidence_scores":[],"chain_of_custody_issues":[],"applied_principles":[],"case_articles":[],"confession_assessments":[],"witness_credibility_scores":[],"prosecution_theory":null,"prosecution_arguments":[],"defense_arguments":[],"aggravating_factors":[],"mitigating_factors":[],"applicable_article_17":false,"charge_conviction_map":{},"civil_claim":null,"civil_award_suggested":null,"suggested_verdict":{"verdict":"براءة","recommended_penalty":null,"per_charge_rulings":[{"charge_description":"الضرب المفضي إلى الموت، جناية، وفقاً لطبيعة الواقعة","verdict":"براءة","penalty":null,"reasoning":"تُفسَّر شبهات الإجراءات لصالح المتهم. تم التفتيش والضبط بدون أمر قضائي أو حالة تلبس، ما يُعد بطلاناً مطلقاً وفقاً للمادة 45 من قانون الإجراءات الجنائية. الأدلة المستمدة من هذين الإجراءين باطلة ولا يُعتد بها. لم يُقدَّم دليل سليم على قيام رابطة سببية بين فعل المتهم والوفاة، كما لم يُثبت الاعتراف أو شهادة مقبولة. الدفوع المتعلقة ببطلان الإجراءات قبلت، وأثر البطلان جوهري، مما يُفقِد الدعوى أساسها الإثباتي."}],"operative_text":"حكمت المحكمة حضورياً: بتبرئة المتهم أحمد محمد علي من تهمة الضرب المفضي إلى الموت، وبإلغاء كل إجراءات الضبط والتفتيش غير المشروعة، وبإحالة مأمور الضبط إلى التحقيق إن كان متجاوزاً، وبالمصاريف.","confidence_score":0.95},"verdict_preamble":"المحكمة: محكمة جنح الجيزة، الدائرة الخامسة، جلسة 2024-04-05، رقم القضية: CASE-2026-001","verdict_facts":"في يوم 9 يناير 2024، وقعت مشاجرة بشارع النيل بالجيزة، تخللها اعتداء بالضرب على شخص نتج عنه وفاته. تم القبض على المتهم أحمد محمد علي من قبل النقيب محمود حسن دون أمر قضائي أو حالة تلبس، كما تم تفتيش مكان الحادث دون إذن من النيابة العامة أو قرار من القضاء. وبناء على ذلك، تم جمع أدلة من خلال إجراءين باطلين قانوناً.","verdict_reasoning":"تُفسَّر شبهات الإجراءات لصالح المتهم. تم التفتيش والضبط بدون أمر قضائي أو حالة تلبس، ما يُعد بطلاناً مطلقاً وفقاً للمادة 45 من قانون الإجراءات الجنائية. الأدلة المستمدة من هذين الإجراءين باطلة ولا يُعتد بها. لم يُقدَّم دليل سليم على قيام رابطة سببية بين فعل المتهم والوفاة، كما لم يُثبت الاعتراف أو شهادة مقبولة. الدفوع المتعلقة ببطلان الإجراءات قبلت، وأثر البطلان جوهري، مما يُفقِد الدعوى أساسها الإثباتي.","verdict_operative":"حكمت المحكمة حضورياً: بتبرئة المتهم أحمد محمد علي من تهمة الضرب المفضي إلى الموت، وبإلغاء كل إجراءات الضبط والتفتيش غير المشروعة، وبإحالة مأمور الضبط إلى التحقيق إن كان متجاوزاً، وبالمصاريف.","completed_agents":["data_ingestion","procedural_auditor","judge"],"errors":[],"current_agent":null,"last_updated":"2026-05-25T12:00:23.840696","source_documents":["Datasets\\User_Cases\\CASE-2026-001"],"extraction_notes":null}}
